diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 2456f7d..57d1b82 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4770,6 +4770,76 @@ static bool ggml_backend_cuda_get_available_uma_memory(long * available_memory_k
 }
 #endif // defined(__linux__)
 
+#if defined(__linux__) && defined(GGML_USE_HIP)
+// Read VRAM (and GTT for iGPUs) from the DRM sysfs for a given PCI slot.
+// For integrated/UMA GPUs (e.g. gfx1151 / Strix Halo) the GTT pool is the
+// system RAM made accessible to the GPU, so we add it to get the full budget.
+// /proc/meminfo MemAvailable is NOT used: it reports free host RAM which
+// severely undercounts VRAM on APUs with large system RAM.
+#include <glob.h>
+static bool ggml_backend_cuda_get_drm_memory(const std::string & pci_bus_id, bool is_integrated, size_t * free, size_t * total) {
+    auto read_u64 = [](const std::string & path, uint64_t & out) -> bool {
+        FILE * f = fopen(path.c_str(), "r");
+        if (!f) return false;
+        bool ok = fscanf(f, "%" SCNu64, &out) == 1;
+        fclose(f);
+        return ok;
+    };
+
+    glob_t gl;
+    if (glob("/sys/class/drm/card*/device/uevent", GLOB_NOSORT, nullptr, &gl) != 0) {
+        return false;
+    }
+
+    bool found = false;
+    for (size_t i = 0; i < gl.gl_pathc; ++i) {
+        FILE * f = fopen(gl.gl_pathv[i], "r");
+        if (!f) continue;
+        char line[256];
+        bool match = false;
+        while (fgets(line, sizeof(line), f)) {
+            if (strncmp(line, "PCI_SLOT_NAME=", 14) == 0) {
+                char slot[64] = {};
+                sscanf(line + 14, "%63s", slot);
+                std::string sysfs_slot(slot);
+                std::string hip_id = pci_bus_id;
+                std::transform(sysfs_slot.begin(), sysfs_slot.end(), sysfs_slot.begin(), ::tolower);
+                std::transform(hip_id.begin(), hip_id.end(), hip_id.begin(), ::tolower);
+                if (hip_id == sysfs_slot) { match = true; }
+                break;
+            }
+        }
+        fclose(f);
+        if (!match) continue;
+
+        std::string dir = std::string(gl.gl_pathv[i]);
+        dir = dir.substr(0, dir.rfind('/'));
+
+        uint64_t vram_total = 0, vram_used = 0;
+        if (!read_u64(dir + "/mem_info_vram_total", vram_total) ||
+            !read_u64(dir + "/mem_info_vram_used",  vram_used)) {
+            break;
+        }
+
+        uint64_t gtt_total = 0, gtt_used = 0;
+        if (is_integrated) {
+            read_u64(dir + "/mem_info_gtt_total", gtt_total);
+            read_u64(dir + "/mem_info_gtt_used",  gtt_used);
+        }
+
+        *total = vram_total + gtt_total;
+        *free  = (vram_total - vram_used) + (gtt_total - gtt_used);
+        GGML_LOG_DEBUG("%s: pci=%s vram_total=%" PRIu64 " vram_used=%" PRIu64
+                       " gtt_total=%" PRIu64 " gtt_used=%" PRIu64 "\n",
+                       __func__, pci_bus_id.c_str(), vram_total, vram_used, gtt_total, gtt_used);
+        found = true;
+        break;
+    }
+    globfree(&gl);
+    return found;
+}
+#endif // defined(__linux__) && defined(GGML_USE_HIP)
+
 static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t * free, size_t * total) {
     ggml_backend_cuda_device_context * ctx = (ggml_backend_cuda_device_context *)dev->context;
     ggml_cuda_set_device(ctx->device);
@@ -4805,6 +4875,22 @@ static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t *
     }
 #endif // defined(__linux__) && !defined(GGML_USE_HIP)
 
+// Upstream skips the UMA path above for HIP builds, which leaves hipMemGetInfo
+// reporting only the small dedicated VRAM carve-out on APUs such as gfx1151
+// (Strix Halo). Read the real VRAM+GTT budget from the DRM sysfs instead.
+#if defined(__linux__) && defined(GGML_USE_HIP)
+    if (!ctx->pci_bus_id.empty()) {
+        cudaDeviceProp prop;
+        CUDA_CHECK(cudaGetDeviceProperties(&prop, ggml_cuda_get_physical_device(ctx->device)));
+        bool is_integrated = prop.integrated > 0;
+        size_t drm_free = 0, drm_total = 0;
+        if (ggml_backend_cuda_get_drm_memory(ctx->pci_bus_id, is_integrated, &drm_free, &drm_total)) {
+            *free  = drm_free;
+            *total = drm_total;
+        }
+    }
+#endif // defined(__linux__) && defined(GGML_USE_HIP)
+
     // virtual devices sharing one physical GPU share its memory pool; split it between them
     const int share_count = ggml_cuda_physical_device_share_count(ctx->device);
     *free  /= share_count;
